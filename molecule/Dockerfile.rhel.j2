FROM {{ item.image }}

ENV container=podman

# Install packages needed by the role and molecule
RUN dnf install -y \
        systemd \
        python3 sudo bash git openssh-clients hostname \
        podman dbus fuse-overlayfs ca-certificates nftables && \
    dnf clean all && \
    # Remove unnecessary systemd services that may interfere in containers
    rm -f /usr/lib/systemd/system/multi-user.target.wants/* && \
    rm -f /etc/systemd/system/*.wants/* && \
    rm -f /usr/lib/systemd/system/local-fs.target.wants/* && \
    rm -f /usr/lib/systemd/system/sockets.target.wants/*udev* && \
    rm -f /usr/lib/systemd/system/sockets.target.wants/*initctl* && \
    rm -f /usr/lib/systemd/system/basic.target.wants/* && \
    rm -f /usr/lib/systemd/system/anaconda.target.wants/* && \
    # Re-enable dbus socket (cleared by basic.target cleanup above).
    # dbus-broker is socket-activated on RHEL/CentOS; without this the system
    # bus is unavailable and user@0.service cannot start.
    systemctl enable dbus.socket

# Make network-online.target reachable on boot so quadlet pod services don't
# hang polling for it. Mask the wait-online service (no real network stack in a
# container) and want the target from multi-user.target so it activates at boot.
RUN ln -sf /dev/null /etc/systemd/system/systemd-networkd-wait-online.service && \
    mkdir -p /etc/systemd/system/multi-user.target.wants && \
    ln -sf /usr/lib/systemd/system/network-online.target /etc/systemd/system/multi-user.target.wants/network-online.target

# Avoid subnet conflict: the outer Molecule container uses podman's default
# 10.88.0.0/16 subnet, so reconfigure the inner podman to use 10.89.0.0/16.
RUN printf '[network]\ndefault_subnet = "10.89.0.0/16"\n' > /etc/containers/containers.conf

# Set up rootless podman / user systemd prerequisites
RUN mkdir -p /run/user/0 && chmod 700 /run/user/0 && \
    mkdir -p /var/lib/systemd/linger && touch /var/lib/systemd/linger/root

# Set root password to fix PAM authentication for user@0.service
# PAM requires password authentication info; setting a plaintext password
# resolves "could not obtain user info" errors when starting user@0.service
RUN echo 'root:root' | chpasswd

ENV XDG_RUNTIME_DIR=/run/user/0

VOLUME ["/sys/fs/cgroup"]

CMD ["/usr/lib/systemd/systemd"]
